"""oldchat/_redact.py - 日志脱敏工具。

任何可能进入日志的字符串（异常信息、服务端回显、URL）都应经过
本模块处理，避免账号、密码、Token 等敏感信息明文泄露。
"""
from __future__ import annotations

import re
from urllib.parse import urlsplit, urlunsplit

_MASK = "***"

# 匹配形如 token=xxx / "password":"xxx" / Authorization: Bearer xxx 的片段
_PATTERNS = [
    (
        re.compile(r"(?i)(authorization\s*[:=]\s*)(bearer\s+)?[A-Za-z0-9._\-+/=]+"),
        r"\1\2" + _MASK,
    ),
    (
        re.compile(
            r"(?i)((?:access|refresh)?_?token\s*[:=]\s*[\"']?)[^\"'\s,&}]+"
        ),
        r"\1" + _MASK,
    ),
    (re.compile(r"(?i)(password\s*[:=]\s*[\"']?)[^\"'\s,&}]+"), r"\1" + _MASK),
    (re.compile(r"(?i)(secret\s*[:=]\s*[\"']?)[^\"'\s,&}]+"), r"\1" + _MASK),
    (re.compile(r"(?i)(sid\s*[:=]\s*[\"']?)[^\"'\s,&}]+"), r"\1" + _MASK),
]


def mask(value: str | None, keep: int = 3) -> str:
    """把敏感值折叠成 ``abc***xyz`` 形式，用于用户名等半敏感字段。"""
    if not value:
        return _MASK
    s = str(value)
    if len(s) <= keep * 2:
        return _MASK
    return f"{s[:keep]}{_MASK}{s[-keep:]}"


def redact(text: object) -> str:
    """对任意文本做敏感字段清洗，用于异常信息和接口回显。"""
    if text is None:
        return ""
    s = str(text)
    for pattern, repl in _PATTERNS:
        s = pattern.sub(repl, s)
    return s


def safe_url(url: str | None) -> str:
    """去掉 URL 中的 query / fragment，避免 token 出现在日志里。"""
    if not url:
        return _MASK
    try:
        p = urlsplit(str(url))
        return urlunsplit((p.scheme, p.netloc, p.path, "", ""))
    except Exception:
        return _MASK